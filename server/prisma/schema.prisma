datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  markers   Marker[]

  @@map("categories")
}

model Marker {
  id            String   @id @default(uuid())
  title         String
  description   String   @default("")
  x             Float
  y             Float
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     String   @map("created_by")
  createdByName String   @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Anchor timestamp for the 24h "Unternehmen" collect timer (see routes/markers.ts's
  // POST /:id/collect) and the 15-minute cooldown on the "Abholen" button — both are derived
  // from this on the client rather than stored as a countdown, which would go stale. Harmless
  // and unused for markers of any other category. Defaults to now() so a freshly created
  // business starts with a full 24h.
  lastCollectedAt DateTime @default(now()) @map("last_collected_at")

  @@index([categoryId])
  @@map("markers")
}
