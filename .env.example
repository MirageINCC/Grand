# Postgres (used by docker-compose.yml and docker-compose.dev.yml)
POSTGRES_USER=gta_map
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gta_map

# Server
# In dev, point this at the port from docker-compose.dev.yml (5432, localhost).
# In prod (full docker-compose.yml), the "app" service builds this from the vars above.
DATABASE_URL=postgresql://gta_map:change-me@localhost:5432/gta_map
PORT=3000
NODE_ENV=development

# Discord OAuth app (developer portal -> your application -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect URL registered in the Discord developer portal
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Discord bot (developer portal -> your application -> Bot). Used server-side only,
# to look up the logged-in user's roles in DISCORD_GUILD_ID. No message/command intents needed.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs (snowflakes) whose members may create/edit/delete markers
ADMIN_ROLE_IDS=

# Used to sign the session JWT cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# After running `npm run tiles`, the script prints a MAX_ZOOM value — set it as
# MAX_ZOOM in client/src/config.ts (no server-side env var needed, only the
# client's Leaflet setup needs it).
