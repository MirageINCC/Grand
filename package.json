{
  "name": "gta-map",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "tiles": "npm run tiles --workspace server --",
    "build": "npm run build --workspace client && npm run build --workspace server"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
